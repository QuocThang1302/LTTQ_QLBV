<UserControl x:Class="QuanLyBenhVien.View.VatDung"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QuanLyBenhVien.View"
             xmlns:customControls="clr-namespace:QuanLyBenhVien.CustomControls"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d"
             d:DesignHeight="650"
        d:DesignWidth="850">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- 1. Thanh tìm kiếm -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Form thông tin -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Danh sách DataGrid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Search Bar -->
        <customControls:Search Margin="0,0,0,15"
                HorizontalAlignment="Stretch"/>

        <!-- 2. Form Nhập Thông Tin -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20,15"
                Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                        Color="#000000"
                        Direction="270"
                        Opacity="0.08"
                        ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề form -->
                <TextBlock Grid.Row="0"
                           Text="THÔNG TIN VẬT DỤNG"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           FontFamily="Segoe UI"
                           Margin="0,0,0,15"/>

                <!-- Layout 2 cột cho Form nhập -->
                <UniformGrid Grid.Row="1"
                        Columns="2"
                        Rows="3">
                    <!-- Mã vật dụng -->
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Mã vật dụng"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Margin="0,0,0,5"/>
                        <TextBox x:Name="tbMaVatDung"
                                Style="{StaticResource TextBoxStyles}"
                                Width="Auto"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Tên vật dụng -->
                    <StackPanel Margin="15,0,0,10">
                        <TextBlock Text="Tên vật dụng"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Margin="0,0,0,5"/>
                        <TextBox x:Name="tbVatDung"
                                Style="{StaticResource TextBoxStyles}"
                                Width="Auto"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Mô tả -->
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Mô tả"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Margin="0,0,0,5"/>
                        <TextBox x:Name="tbMoTa"
                                Style="{StaticResource TextBoxStyles}"
                                Width="Auto"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Giá tiền -->
                    <StackPanel Margin="15,0,0,10">
                        <TextBlock Text="Giá tiền"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Margin="0,0,0,5"/>
                        <TextBox x:Name="tbGiaTien"
                                Style="{StaticResource TextBoxStyles}"
                                Width="Auto"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Số lượng -->
                    <StackPanel Margin="0,0,15,10">
                        <TextBlock Text="Số lượng"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Margin="0,0,0,5"/>
                        <TextBox x:Name="tbSoLuong"
                                Style="{StaticResource TextBoxStyles}"
                                Width="Auto"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Người quản lý -->
                    <StackPanel Margin="15,0,0,10">
                        <TextBlock Text="Người quản lý"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Margin="0,0,0,5"/>
                        <TextBox x:Name="tbQuanLy"
                                Style="{StaticResource TextBoxStyles}"
                                Width="Auto"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Thanh Nút Bấm Hành Động -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Làm mới"
                            Style="{StaticResource childviewButton}"
                            Background="#64748B"
                            Width="90"
                            Margin="0,0,10,0"/>

                    <Button Content="Thêm"
                            Style="{StaticResource childviewButton}"
                            Width="90"
                            Margin="0,0,10,0"/>

                    <Button Content="Cập nhật"
                            Style="{StaticResource childviewButton}"
                            Background="#0D9488"
                            Width="100"
                            Margin="0,0,10,0"/>

                    <Button Content="Xóa"
                            Style="{StaticResource childviewButton}"
                            Background="#E11D48"
                            Width="90"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Danh Sách DataGrid -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                        Color="#000000"
                        Direction="270"
                        Opacity="0.08"
                        ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="DANH SÁCH VẬT DỤNG"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           FontFamily="Segoe UI"
                           Margin="5,0,0,10"/>

                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeight="36"
                          HeadersVisibility="Column">

                    <!-- Header Style -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"
                                    Value="#F1F5F9"/>
                            <Setter Property="Foreground"
                                    Value="#334155"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Left"/>
                            <Setter Property="FontFamily"
                                    Value="Segoe UI"/>
                            <Setter Property="FontSize"
                                    Value="13"/>
                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>
                            <Setter Property="Padding"
                                    Value="10,0"/>
                            <Setter Property="Height"
                                    Value="38"/>
                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1"/>
                            <Setter Property="BorderBrush"
                                    Value="#CBD5E1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Cell Style -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding"
                                    Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderThickness="0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="#E0E7FF"/>
                                    <Setter Property="Foreground"
                                            Value="#1E40AF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Row Style -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="#F8FAFC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Columns -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã vật dụng"
                                Binding="{Binding MaVatDung}"
                                Width="1.2*"/>
                        <DataGridTextColumn Header="Tên vật dụng"
                                Binding="{Binding TenVatDung}"
                                Width="2*"/>
                        <DataGridTextColumn Header="Mô tả"
                                Binding="{Binding MoTa}"
                                Width="2.5*"/>
                        <DataGridTextColumn Header="Số lượng"
                                Binding="{Binding SoLuong}"
                                Width="1*"/>
                        <DataGridTextColumn Header="Giá tiền"
                                Binding="{Binding GiaTien}"
                                Width="1.2*"/>
                        <DataGridTextColumn Header="Mã quản lý"
                                Binding="{Binding MaQuanLy}"
                                Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>